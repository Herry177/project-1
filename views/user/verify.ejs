<% layout("/layouts/boilerplate") %>

<div class="row mb-3 mt-4">
  <h2 class="col-6 offset-3 text-center">
    Verify<span class="text-success"> Your Account</span>
  </h2>
  <div class="col-6 offset-3">
    <div class="w-full bg-white p-8 rounded-lg shadow-md">
      <p class="text-gray-600 mb-4 text-center">
        A verification code has been sent to <strong><%= email %></strong>.
      </p>

      <form action="/verify" method="POST" class="needs-validation" novalidate>
        <!-- Hidden email field ensures email always sent -->
        <input type="hidden" name="email" value="<%= email %>">

        <div class="mt-3 mb-4">
          <label class="form-label" for="code">Verification Code</label>
          <input
            type="text"
            name="code"
            id="code"
            placeholder="6-digit Code"
            minlength="6"
            maxlength="6"
            class="form-control"
            required
          />
          <div class="invalid-feedback">
            Please enter a 6-digit verification code!
          </div>
        </div>

        <button type="submit" class="btn btn-outline-success w-full">Verify</button>
      </form>

      <hr class="my-4" />

      <h5 class="text-center">Didn't receive a code?</h5>
      <p class="text-center">
        Please check your spam folder or <a href="/signup" class="text-blue-600">sign up again</a>.
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    'use strict'
    const forms = document.querySelectorAll('.needs-validation')
    Array.from(forms).forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>

<% layout("/layouts/boilerplate") %>

<div class="row mb-3 mt-4">
  <h2 class="col-6 offset-3 signup-heading">
    Sign<span class="text-success">Up</span> <span>For</span>
    <b><span class="text-danger" id="app1"></span></b>
  </h2>
  <div class="col-6 offset-3">
    <div id="skeleton-signup">
      <form novalidate class="needs-validation">
        <div class="mt-3 mb-4">
          <div class="skeleton-signup-label"></div>
          <div class="skeleton-signup-input"></div>
        </div>

        <div class="mb-4">
          <div class="skeleton-signup-label"></div>
          <div class="skeleton-signup-input"></div>
        </div>

        <div class="mb-4">
          <div class="skeleton-signup-label"></div>
          <div class="skeleton-signup-input"></div>
          <div class="d-flex gap-2 mt-2">
            <div class="skeleton-signup-btn"></div>
            <div class="skeleton-signup-btn"></div>
          </div>
        </div>

        <div class="skeleton-signup-submit mt-2"></div>
      </form>
    </div>

    <div id="signup-contains" style="display: none">
      <form method="post" action="/signup" novalidate class="needs-validation">
        <div class="mt-3 mb-4">
          <label class="form-label signup-label" for="username">Username</label>
          <input
            type="text"
            name="username"
            id="username"
            class="form-control"
            required
          />
          <div class="valid-feedback">Looks Good!</div>
        </div>

        <div class="mb-4">
          <label class="form-label signup-label" for="email">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            class="form-control"
            required
          />
          <div class="invalid-feedback">
            Please enter right email or in valid form!
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label signup-label" for="password">Password</label>
          <input
            type="password"
            name="password"
            id="password"
            class="form-control passfield random-pass"
            required
          />
          <button type="button" class="random btn btn-primary mt-2">
            Genpass
          </button>
          <button type="button" class="eye opt btn btn-secondary mt-2">
            See pass
          </button>
        </div>
        <button type="submit" class="btn btn-outline-success">SignUp</button>
      </form>
    </div>
  </div>
</div>
<hr class="col-6 offset-3">
<h5 class="text-center">Or sign up with</h5>
<div class="d-flex justify-content-center mb-5">
  <a
    href="/auth/google"
    class="btn btn-outline-primary d-flex align-items-center"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 48 48"
      width="48px"
      height="48px"
    >
      <path
        fill="#FFC107"
        d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"
      />
      <path
        fill="#FF3D00"
        d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"
      />
      <path
        fill="#4CAF50"
        d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"
      />
      <path
        fill="#1976D2"
        d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"
      />
    </svg>
    <span class="ms-2">Sign up with Google</span>
  </a>
</div>

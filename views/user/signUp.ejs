<% layout("/layouts/boilerplate") %>

<div class="row mb-3">
  <h2 class="col-6 offset-3">
    Sign<span class="text-success">Up</span> <span>For</span>
    <b><span class="text-danger" id="app1"></span></b>
  </h2>
  <div class="col-6 offset-3">
    <form method="post" action="/signup" novalidate class="needs-validation">
      <div class="mt-3 mb-4">
        <label class="form-label" for="username">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks Good!</div>
      </div>

      <div class="mb-4">
        <label class="form-label" for="email">Email</label>
        <input
          type="email"
          name="email"
          id="email"
          class="form-control"
          required
        />
        <div class="invalid-feedback">
          Please enter right email or in valid form!
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control passfield random-pass"
          required
        />
        <button type="button" class="random btn btn-primary mt-2">Genpass</button>
        <i class="fa-solid fa-eye opt eye"></i>
      </div>
      <button type="submit" class="btn btn-outline-success">SignUp</button>
    </form>
  </div>
</div>

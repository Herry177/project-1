<% layout("/layouts/boilerplate") %>

<div class="row mb-3">
  <h2 class="col-6 offset-3">
    Log<span class="text-success">In</span>
    <b><span class="text-danger" id="app"></span></b>
  </h2>
  <div class="col-6 offset-3">
    <form method="post" action="/login" novalidate class="needs-validation">
      <div class="mt-3 mb-4">
        <label class="form-label" for="username">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        />
      </div>

      <div class="mb-4">
        <label class="form-label" for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control passfield"
          required
        />
        <button type="button" class="eye opt btn btn-secondary mt-2">See pass</button>
      </div>

      <button class="btn btn-outline-success">LogIn</button>
    </form>
  </div>
</div>

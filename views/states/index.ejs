<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-10 offset-1 col-lg-6 offset-lg-3">
    <h3 class="mb-3">Browse by State / Union Territory</h3>

    <% if(allStates && allStates.length) { %>
      <div class="list-group">
        <% allStates.forEach(state => { %>
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= state.name %></span>
            <div class="btn-group">
              <a href="/listings?state=<%= state._id %>" class="btn btn-sm btn-outline-dark">Listings</a>
              <a href="/places?state=<%= state._id %>" class="btn btn-sm btn-outline-primary">Places</a>
              <a href="/shops?state=<%= state._id %>" class="btn btn-sm btn-outline-success">Shops</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No states available.</p>
    <% } %>
  </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Great+Vibes&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" xintegrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/searchBased.css">
</head>
<body >
    <%- include("./includes/navbar.ejs") %>
    <div class="container">
        <!-- Main Header -->
        <h1 class="main-headline">
            Discover the Best of <%= statename %>
        </h1>

        <!-- Trending Listings Section -->
        <% if (hotels && hotels.length > 0) { %>
            <div>
                <h2 class="section-headline">Hotels</h2>
                <div class="flex overflow-x-hidden">
                    <!-- Changed class to scroll-container-rtl for right-to-left animation -->
                    <div class="scroll-container scroll-container-rtl flex space-x-6 pb-4">
                        <% hotels.forEach(hotel => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/listings/<%= hotel._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= hotel.image[0] ? hotel.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= hotel.title %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= hotel.title %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= hotel.price ? '₹' + hotel.price.toLocaleString("en-IN") + ' / night' : 'Price not available' %> <i class="tax-info">&nbsp;&nbsp; +18% GST</i></p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                        <!-- Duplicate content for seamless looping -->
                        <% hotels.forEach(hotel => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/listings/<%= hotel._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= hotel.image[0] ? hotel.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= hotel.title %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= hotel.title %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= hotel.price ? '₹' + hotel.price.toLocaleString("en-IN") + ' / night' : 'Price not available' %> <i class="tax-info">&nbsp;&nbsp; +18% GST</i></p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Trending Places Section -->
        <% if (touristPlaces && touristPlaces.length > 0) { %>
            <div>
                <h2 class="section-headline">Trending Tourist Places</h2>
                <div class="flex overflow-x-hidden">
                    <div class="scroll-container scroll-container-ltr flex space-x-6 pb-4">
                        <% touristPlaces.forEach(touristPlace => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/places/<%= touristPlace._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= touristPlace.image[0] ? touristPlace.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= touristPlace.place_name %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= touristPlace.place_name %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= touristPlace.type %></p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                        <!-- Duplicate content for seamless looping -->
                        <% touristPlaces.forEach(touristPlace => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/places/<%= touristPlace._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= touristPlace.image[0] ? touristPlace.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= touristPlace.place_name %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= touristPlace.place_name %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= touristPlace.type %></p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% } %>
        
        <!-- Trending Shops Section -->
        <% if (localShops && localShops.length > 0) { %>
            <div class="mb-2">
                <h2 class="section-headline">Trending Shops</h2>
                <div class="flex overflow-x-hidden">
                    <div class="scroll-container scroll-container-rtl flex space-x-6 pb-4">
                        <% localShops.forEach(localShop => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/shops/<%= localShop._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= localShop.image[0] ? localShop.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= localShop.name %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= localShop.name %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= localShop.category %> Shop</p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                        <!-- Duplicate content for seamless looping -->
                        <% localShops.forEach(localShop => { %>
                            <div class="card-wrapper flex-shrink-0">
                                <a href="/shops/<%= localShop._id %>" class="listing-link">
                                    <div class="card listing-card bg-white rounded-xl shadow-md overflow-hidden">
                                        <div class="relative">
                                            <img src="<%= localShop.image[0] ? localShop.image[0].url : 'https://placehold.co/400x300' %>" alt="<%= localShop.name %>" class="card-img-top w-full h-full object-cover rounded-t-xl"/>
                                        </div>
                                        <div class="card-body p-4">
                                            <h3 class="text-lg font-semibold text-gray-900 truncate"><%= localShop.name %></h3>
                                            <p class="card-text text-gray-700 mt-1"><%= localShop.category %> Shop</p>
                                        </div>
                                        <div class="listing-overlay absolute inset-0 rounded-xl">
                                            <p class="overlay-text">See Details</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% } %> 

        

        <!-- No Results Found Message -->
        <% if (hotels.length === 0 && localShops.length === 0 && touristPlaces.length === 0) { %>
            <div class="no-results">
                <p>No Hotels, Local Shops, or Tourist Places found for <%= statename %>.</p>
                <p class="mt-2">Please try searching for a different state.</p>
            </div>
        <% } %>

    </div>
    <%- include("./includes/footer.ejs") %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const userMenuToggle = document.getElementById('user-menu-toggle');
            const userDropdownMenu = document.querySelector('.user-dropdown-menu');

            if (userMenuToggle && userDropdownMenu) {
                userMenuToggle.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation(); // Prevent the body click from closing it immediately
                    userDropdownMenu.classList.toggle('active');
                });

                document.body.addEventListener('click', (e) => {
                    if (!userDropdownMenu.contains(e.target) && !userMenuToggle.contains(e.target)) {
                        userDropdownMenu.classList.remove('active');
                    }
                });
            }
        });
    </script>
</body>
</html>

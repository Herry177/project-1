<% layout("/layouts/boilerplate") %>

<div
  class="main-con"
  style="display: flex; justify-content: center; align-items: center"
>
  <div id="filter-container" style="width: 35.5%">
    <i class="fa-solid fa-caret-left btns-scroll"></i>
    <div class="filters">
      <div class="filter-opt">
        <a href="/shops/category/Trending">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/shops/category/5-star">
          <div><i class="fa-solid fa-star"></i></div>
          <p>5-star</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/shops/category/Food">
          <div><i class="fa-solid fa-utensils"></i></div>
          <p>Food</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/shops/category/Handicraft">
          <div><i class="fa-solid fa-hand-sparkles"></i></div>
          <p>Handicraft</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/shops/category/Clothing">
          <div><i class="fa-solid fa-shirt"></i></div>
          <p>Clothing</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/shops/category/Other">
          <div><i class="fa-solid fa-store"></i></div>
          <p>Other</p>
        </a>
      </div>
    </div>
    <i class="fa-solid fa-caret-right btns-scroll"></i>
  </div>
</div>

<div id="skeleton-container">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let i = 0; i < 6; i++) { %>
    <div class="card col listing-card skeleton-card">
      <div class="skeleton-img"></div>
      <div class="card-body mt-1">
        <div class="skeleton-line title"></div>
        <div class="skeleton-line price"></div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<div id="listing-container" style="display: none">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (shop of allShops) { %>
    <a href="/shops/<%= shop._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= shop.image[0].url %>"
          class="card-img-top"
          alt="shop_image"
          style="height: 20rem"
        />
        <div class="card-img-overlay listing-overlay">
          <p class="overlay-text">See Details</p>
        </div>
        <div class="card-body mt-1">
          <p class="card-text">
            <b><%= shop.name %></b> <br />
            <%= shop.category %> Shop
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>
</div>

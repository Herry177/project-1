<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <img
    class="err-img col-6 offset-3"
    src="<% if (no === 1){ %> /images/Gemini_Generated_Image_7g931w7g931w7g93.jpg 
        <% }  else if (no === 2){ %> /images/Gemini_Generated_Image_wrzw18wrzw18wrzw.jpg 
        <% }  else { %> /images/Gemini_Generated_Image_hbg0xdhbg0xdhbg0.jpg<% } %>"
    alt="Img"
  />
  <div
    class="alert alert-danger col-10 offset-1 d-flex align-items-center"
    role="alert"
  >
    <i
      class="fa-solid fa-triangle-exclamation text-danger"
      style="margin-bottom: 0.2rem"
    ></i>
    <div class="ms-2"><%= err.message %></div>
  </div>
</div>

<% layout("/layouts/boilerplate") %>
<script>
  let map_Token = "<%= process.env.MAP_TOKEN%>";
  let listing = <%- JSON.stringify(listing) %>;
</script>
<div class="row mt-3 mb-5">
  <div class="col-10 offset-1 col-lg-6 offset-lg-3">
    <h3 class="mb-3"><%= listing.title %></h3>
  </div>

  <div id="skeleton-container2">
    <div class="row mt-3 mb-5 listing-skeleton">
      <div class="card col-10 offset-1 col-lg-6 offset-lg-3 show-card listing-card">
        <div class="skeleton-img-container">
          <div class="skeleton skeleton-img"></div>
        </div>
        <div class="card-body p-3">
          <div class="skeleton skeleton-text mb-2 w-50"></div>
          <div class="skeleton skeleton-text mb-2 w-100"></div>
          <div class="skeleton skeleton-text mb-2 w-75"></div>
          <div class="skeleton skeleton-text mb-2 w-50"></div>
          <div class="skeleton skeleton-text mb-2 w-25"></div>
        </div>
      </div>
      <div class="col-10 offset-1 col-lg-6 offset-lg-3 mt-4">
        <div class="skeleton skeleton-subtitle mb-2 w-50"></div>
        <div class="d-flex gap-3">
          <div class="skeleton skeleton-input w-50"></div>
          <div class="skeleton skeleton-input w-50"></div>
        </div>
        <div class="skeleton skeleton-button mt-4 w-100"></div>
      </div>
      <div class="col-10 offset-1 col-lg-6 offset-lg-3 mt-5">
        <div class="skeleton skeleton-subtitle mb-3 w-25"></div>
        <div class="d-flex align-items-center justify-content-between">
          <div class="skeleton skeleton-box w-25"></div>
          <div class="skeleton skeleton-box w-25"></div>
        </div>
      </div>
      <div class="col-10 offset-1 col-lg-6 offset-lg-3 mt-4">
        <div class="skeleton skeleton-subtitle mb-3 w-25"></div>
        <div class="skeleton skeleton-map w-100"></div>
      </div>
    </div>
  </div>

  <div id="main-container" style="display: none">
    <div class="card col-10 offset-1 col-lg-6 offset-lg-3 show-card listing-card">
      <div class="img-container" id="img-container">
        <% for(image of listing.image) {%>
        <img
          src="<%= image.url %>"
          class="slide card-img-top show-img"
          alt="listing_image"
        />
        <%}%>
        <button class="previous">
          <i class="fa-solid fa-circle-chevron-left"></i>
        </button>
        <button class="next">
          <i class="fa-solid fa-circle-chevron-right"></i>
        </button>
      </div>

      <div class="card-body">
        <p class="card-text">
          <i>Owned by <%= listing.owner.username %></i>
        </p>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text"><b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN") %></p>
        <p class="card-text"><b>Country:</b> <%= listing.country %></p>
        <p class="card-text"><b>State:</b> <%= listing.state?.name %></p>
        <p class="card-text"><b>Location:</b> <%= listing.location %></p>
        <p class="card-text"><b>Category:</b> <%= listing.category %></p>
        <p class="card-text">
          <% if (sum > 0) {%>
          <span>Rating: <%= Number(sum).toFixed(1) %></span>
          <% } else { %>
          <span>No rating yet</span>
          <% } %>
          <span class="rating">
            <% if (sum > 0) { %> <% for (let i = 1; i <= sum; i++) { %>
            <i class="fa-solid fa-star"></i>
            <% } %> <% } %> <% if (sum > 0 && sum % 1 != 0) {%>
            <i class="fa-solid fa-star-half-alt"></i>
            <% } %>
          </span>
        </p>
      </div>
    </div>
    <% if(currUser && currUser._id.equals(listing.owner._id)) {%>
    <div style="padding-left: 0rem !important;" class="btns">
      <a
        class="btn-show-edit btn btn-dark col-1 offset-lg-3 offset-1"
        href="/listings/<%= listing._id %>/edit"
        >Edit</a
      >
      <form method="post" action="/listings/<%= listing._id %>?_method=Delete">
        <button class="btn-show-delete btn btn-dark offset-5">Delete</button>
      </form>
    </div>
    <%}%>
    <div style="padding: 0;" class="col-10 offset-1 col-lg-6 offset-lg-3">
      <hr />
      <h5 class="mb-3">Enter Trip Schedule</h5>
      <div class="dates-cont">
        <div>
          <label class="form-label trip-plan-label" for="datepicker">Checkin Date</label>
          <input
            style="width: 80%;"
            class="calender form-control"
            type="text"
            id="checkin"
            placeholder="Select a date"
            required
          />
        </div>
        <div>
          <label class="form-label trip-plan-label" for="datepicker1">Checkout Date</label>
          <input
            style="width: 80%;"
            class="calender form-control"
            type="text"
            id="checkout"
            placeholder="Select a date"
            required
            disabled
          />
        </div>
      </div>
      <button class="btn btn-sm btn-outline-danger mt-4 mb-2 trip-plan-btn">
        Submit
      </button>

      <div id="pricePerNight" style="display: none;">
        <div class="price-card">
          <div class="price"></div>
          <div class="dates-container">
            <div class="check-in">Checkin Date <p class="checkin-date"></p></div>
            <div class="check-out">Checkout Date <p class="checkout-date"></p></div>
          </div>
          <button style="margin-top: 2.5rem; width: 100%;" class="btn btn-sm btn-danger mb-2">
            Reserve
          </button>
          <p style="margin: 0;">You won't be charged yet</p>
        </div>
      </div>
    </div>
    <div style="padding: 0;" class="col-10 offset-1 col-lg-6 offset-lg-3 mb-3">
      <hr />
      <% if(currUser) {%>
      <form
        method="post"
        novalidate
        class="needs-validation"
        action="/listings/<%= listing._id %>/review"
      >
        <div class="mt-3 mb-1">
          <label class="form-label" for="range">Rating</label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3">
          <label class="form-label" for="comment">Comment</label>
          <textarea
            name="review[comment]"
            id="comment"
            rows="5"
            cols="30"
            class="form-control"
            id="comment"
            required
          ></textarea>
          <div class="invalid-feedback">Please add a comment for review.</div>
        </div>
        <button class="btn-show-submit btn btn-outline-danger">Submit</button>
      </form>
      <hr />
      <%}%> <% if(listing.reviews.length > 0){ %>
      <div class="overallview">
        <div class="container-ratings-count">
          <img
            class="rating-deco-img"
            src="https://a0.muscache.com/im/pictures/airbnb-platform-assets/AirbnbPlatformAssets-GuestFavorite/original/78b7687c-5acf-4ef8-a5ea-eda732ae3b2f.png"
            alt="img"
          />
          <div>
            <div class="review-rating-count">
              <% if (sum > 0) {%>
              <span><%= Number(sum).toFixed(1) %></span>
              <% } else { %> <span>No rating yet</span>
              <% } %>
              <span class="rating">
                <% if (sum > 0) { %> <% for (let i = 1; i <= sum; i++) { %>
                <i class="fa-solid fa-star"></i>
                <% } %> <% } %> <% if (sum > 0 && sum % 1 != 0) {%>
                <i class="fa-solid fa-star-half-alt"></i>
                <% } %>
              </span>
            </div>
            <div class="review-rating-count">
              <b>Overall rating</b>
            </div>
          </div>
          <img
            class="rating-deco-img"
            src="https://a0.muscache.com/im/pictures/airbnb-platform-assets/AirbnbPlatformAssets-GuestFavorite/original/b4005b30-79ff-4287-860c-67829ecd7412.png"
            alt="img"
          />
        </div>
        <div class="vertical-line"></div>
        <div class="container-reviews-count">
          <div class="review-rating-count"><%= count %></div>
          <div class="review-rating-count"><b>Reviews</b></div>
        </div>
      </div>
      <hr />
      <p><b>All Reviews</b></p>
      <div class="row">
        <% for (review of listing.reviews){ %>
        <div class="card col-11 col-lg-5 ms-3 mb-3 pt-2">
          <div class="card-body">
            <h5 class="card-title">@<%= review.author.username %></h5>
            <p class="card-text"><%= review.comment %></p>
            <p class="card-text">
              <%= review.rating %>
              <span class="rating"
                ><% for(let i = 1; i <= review.rating; i++) {%><i
                  class="fa-solid fa-star"
                ></i
                ><%}%></span
              >
            </p>
          </div>
          <% if(currUser && currUser._id.equals(review.author._id)) {%>
          <div class="review-btn-container">
            <form
              class="mb-3"
              method="Post"
              action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=Delete "
            >
              <button class="btn btn-sm btn-dark btn-show-delete mt-2">Delete</button>
            </form>
            <a
              href="/listings/<%= listing._id %>/review/<%= review._id %>/edit"
              class="reviewedit"
              ><button class="btn btn-sm btn-dark btn-show-edit ms-3 mb-2">Edit</button></a
            >
          </div>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
  <div style="padding: 0;" class="col-10 offset-1 col-lg-6 offset-lg-3">
    <p><b>WHERE YOU'LL BE</b></p>
    <div id="map"></div>
  </div>
</div>
<script src="/js/map.js"></script>
<script>
  let btn = document.querySelector(".trip-plan-btn");
  let inps = document.querySelectorAll(".calender");
  btn.addEventListener("click", (event) => {
    event.preventDefault();
    for (inp of inps) {
      console.log(inp.value);
    }
  });
</script>
<script>
  const checkoutInput = document.getElementById("checkout");
  const checkinInput = document.getElementById("checkin");

  const checkout = flatpickr("#checkout", {
    enableTime: true,
    dateFormat: "Y-m-d",
    minDate: "today",
    clickOpens: false,
    disableMobile: true,
  });

  const checkin = flatpickr("#checkin", {
    enableTime: true,
    dateFormat: "Y-m-d",
    minDate: "today",
    disableMobile: true,
    onChange: function(selectedDates, dateStr, instance) {
      if (selectedDates[0]) {
        checkoutInput.removeAttribute("disabled");
        checkout.set("minDate", selectedDates[0].fp_incr(1));
        checkout.set("clickOpens", true);
        checkout.clear();
      }
    },
  });

  const tripBtn = document.querySelector(".trip-plan-btn");
  tripBtn.addEventListener("click", () => {
    if (checkoutInput.value) {
      const checkinDate = new Date(checkinInput.value);
      const checkoutDate = new Date(checkoutInput.value);
      let datedisplayIn = document.querySelector(".checkin-date");
      let datedisplayOut = document.querySelector(".checkout-date");

      const diffTime = checkoutDate - checkinDate;
      const nights = diffTime / (1000 * 60 * 60 * 24);

      let platformFees;
      if (nights > 15) {
        platformFees = 3500;
      } else if (nights > 10) {
        platformFees = 3000;
      } else if (nights > 5) {
        platformFees = 2000;
      } else {
        platformFees = 1500;
      }

      let pricePerNightCon = document.querySelector("#pricePerNight");
      pricePerNightCon.style.display = "flex";

      datedisplayIn.innerText = checkinInput.value;
      datedisplayOut.innerText = checkoutInput.value;

      let price = document.querySelector(".price");
      console.log(nights * listing.price);
      console.log(platformFees);
      console.log(nights * listing.price);
      console.log(((nights * listing.price + platformFees) * 18) / 100);
      price.innerHTML = `<b style="font-size: 1.25rem">${
        nights * listing.price +
        platformFees +
        (((nights * listing.price + platformFees) * 18) / 100)
      }&#8377</b>&nbsp;<span style="font-size: 0.8rem; opacity: 0.7; display: flex; align-items: end; padding-bottom: 0.18rem;">&nbsp;For ${nights} night.</span>`;
    }
  });
</script>
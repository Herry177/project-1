<% layout("/layouts/boilerplate") %>

<div class="main-con" style="display: flex; justify-content: center;">
  <div id="filter-container" style="width: 45%;">
    <i class="fa-solid fa-caret-left btns-scroll"></i>
    <div class="filters" >
      <div class="filter-opt">
        <a href="/places/type/Trending">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/5-star">
          <div><i class="fa-solid fa-star"></i></div>
          <p>5-star</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/Cultural">
          <div><i class="fa-solid fa-landmark"></i></div>
          <p>Cultural</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/Adventure">
          <div><i class="fa-solid fa-hiking"></i></div>
          <p>Adventure</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/Historical">
          <div><i class="fa-solid fa-scroll"></i></div>
          <p>Historical</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/Religious">
          <div><i class="fa-solid fa-church"></i></div>
          <p>Religious</p>
        </a>
      </div>
      <div class="filter-opt">
        <a href="/places/type/Nature">
          <div><i class="fa-solid fa-tree"></i></div>
          <p>Nature</p>
        </a>
      </div>
    </div>
    <i class="fa-solid fa-caret-right btns-scroll"></i>
  </div>
</div>

<div id="skeleton-container">
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let i = 0; i < 6; i++) { %>
    <div class="card col place-card skeleton-card">
      <div class="skeleton-img"></div>
      <div class="card-body mt-1">
        <div class="skeleton-line title"></div>
        <div class="skeleton-line price"></div>
      </div>
    </div>
    <% } %>
  </div>
</div>
<div id="listing-container" style="display: none">
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for (place of allPlaces) { %>
        <a href="/places/<%= place._id %>" class="listing-link">
            <div class="card col listing-card">
                <img
                    src="<%= place.image[0]?.url || '/images/placeholder.png' %>"
                    class="card-img-top"
                    alt="place_image"
                    style="height: 20rem"
                />
                <div class="card-img-overlay listing-overlay">
                    <p class="overlay-text">See Details</p>
                </div>
                <div class="card-body mt-1">
                    <p class="card-text">
                        <b><%= place.place_name %></b> <br />
                        <i><%= place.type %></i> <br />
                        <%= place.state?.name || "Unknown State" %>
                    </p>
                </div>
            </div>
        </a>
        <% } %>
    </div>
</div>
